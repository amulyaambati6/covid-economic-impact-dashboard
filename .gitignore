
# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Editors and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Downloaded or generated data
# Intermediate pipeline outputs stay local; the top-level CSV files in
# data/processed/ are tracked because the app reads them.
data/processed/*
!data/processed/.gitkeep
!data/processed/*.csv
clean_stringency/
clean_cases_deaths/

# Generated outputs and logs
*.log
